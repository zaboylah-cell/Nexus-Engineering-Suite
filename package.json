{
  "name": "bro-nexus-desktop",
  "version": "1.0.0",
  "description": "BRO Nexus — BRO PC Toolkit and NEXUS Engineering Suite for Windows and macOS",
  "main": "desktop/main.cjs",
  "author": "zaboylah-cell",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable && node desktop/copy-release-assets.cjs",
    "build:mac": "electron-builder --mac dmg zip && node desktop/copy-release-assets.cjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bronexus.toolkit",
    "productName": "BRO Nexus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "site.json",
      "site.js",
      "desktop/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    }
  }
}